# --- Pasture / Faktu Sales Copilot ---

# Model backend: "mock" (default, deterministic, zero-config) or "openai" (any
# OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, rig/llama-swap, ...)
MODEL=mock

# Used when MODEL=openai
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Server
PORT=8420
HOST=127.0.0.1

# Data (recreate on every start when PASTURE_FRESH=1)
PASTURE_DATA_DIR=./data
PASTURE_FRESH=1
